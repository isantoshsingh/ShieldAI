<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
  <p class="text-yellow-800 font-medium">Super Admin Mode: viewing all organisations</p>
</div>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">All Organisations</h1>
  <%= link_to "New Organisation", new_super_organisation_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm" %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Slug</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Employees</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @organisations.each do |org| %>
        <tr>
          <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= org.name %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= org.slug %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= org.employees_count %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= org.created_at.strftime("%b %-d, %Y") %></td>
          <td class="px-4 py-3 text-sm"><%= link_to "View", super_organisation_path(org), class: "text-indigo-600 hover:text-indigo-500" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= pagy_nav(@pagy) %>
