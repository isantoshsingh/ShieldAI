<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
  <p class="text-yellow-800 font-medium">Super Admin Mode: viewing all organisations</p>
</div>

<h1 class="text-2xl font-bold text-gray-900 mb-6">New Organisation</h1>

<div class="max-w-lg">
  <% if @organisation.errors.any? || @user.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
      <ul class="text-sm text-red-600 list-disc list-inside">
        <% @organisation.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(url: super_organisations_path, method: :post, local: true, class: "space-y-4") do %>
    <div>
      <label class="block text-sm font-medium text-gray-700">Organisation Name</label>
      <input type="text" name="organisation[name]" value="<%= @organisation.name %>" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm px-3 py-2 border" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Admin Name</label>
      <input type="text" name="user[name]" value="<%= @user.name %>" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm px-3 py-2 border" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Admin Email</label>
      <input type="email" name="user[email]" value="<%= @user.email %>" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm px-3 py-2 border" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Admin Password</label>
      <input type="password" name="user[password]" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm px-3 py-2 border" />
    </div>
    <div>
      <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm cursor-pointer">Create Organisation</button>
    </div>
  <% end %>
</div>
