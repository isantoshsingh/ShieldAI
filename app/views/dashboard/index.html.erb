<h1 class="text-2xl font-bold text-gray-900 mb-6">Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white rounded-lg shadow p-6" id="stat-total-sessions">
    <p class="text-sm text-gray-500">Total Sessions</p>
    <p class="text-3xl font-bold text-gray-900"><%= @total_sessions %></p>
  </div>
  <div class="bg-white rounded-lg shadow p-6" id="stat-active-employees">
    <p class="text-sm text-gray-500">Active Employees</p>
    <p class="text-3xl font-bold text-gray-900"><%= @active_employees %></p>
  </div>
  <div class="bg-white rounded-lg shadow p-6" id="stat-unique-tools">
    <p class="text-sm text-gray-500">Unique AI Tools</p>
    <p class="text-3xl font-bold text-gray-900"><%= @unique_tools %></p>
  </div>
  <div class="bg-white rounded-lg shadow p-6" id="stat-sessions-today">
    <p class="text-sm text-gray-500">Sessions Today</p>
    <p class="text-3xl font-bold text-gray-900"><%= @sessions_today %></p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Top AI Tools (Last 30 Days)</h2>
    <%= bar_chart current_organisation.detection_events.last_days(30).joins(:ai_tool).group("ai_tools.name").count.sort_by { |_, v| -v }.first(10).to_h, height: "300px" %>
  </div>
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Sessions Over Time (Last 30 Days)</h2>
    <%= line_chart current_organisation.detection_events.last_days(30).group_by_day(:detected_at).count, height: "300px" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Employee Risk Overview</h2>
  <table class="min-w-full divide-y divide-gray-200">
    <thead>
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Department</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tools Used</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Sessions (30d)</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Seen</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Risk</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @employees.each do |employee| %>
        <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='<%= employee_path(employee) %>'">
          <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= employee.name %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= employee.department || "—" %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= employee.detection_events.select(:ai_tool_id).distinct.count %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= employee.detection_events.last_days(30).count %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= employee.detection_events.maximum(:detected_at)&.strftime("%b %-d, %Y") || "Never" %></td>
          <td class="px-4 py-3 text-sm">
            <% risk = employee.risk_level %>
            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
              <%= risk == 'high' ? 'bg-red-100 text-red-800' : risk == 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800' %>">
              <%= risk.upcase %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Recent Activity</h2>
  <% if @recent_events.any? %>
    <div class="space-y-3">
      <% @recent_events.each do |event| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-100">
          <div class="flex items-center space-x-3">
            <span class="text-lg"><%= event.ai_tool.icon_emoji %></span>
            <div>
              <p class="text-sm font-medium text-gray-900"><%= event.employee.name %></p>
              <p class="text-xs text-gray-500"><%= event.ai_tool.name %></p>
            </div>
          </div>
          <span class="text-xs text-gray-400"><%= time_ago_in_words(event.detected_at) %> ago</span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-500">No activity yet.</p>
  <% end %>
</div>
