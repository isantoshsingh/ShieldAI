<div class="min-h-screen flex items-center justify-center">
  <div class="max-w-md w-full bg-white rounded-lg shadow-lg p-8">
    <h2 class="text-2xl font-bold text-center text-gray-900 mb-6">Sign up for ShieldAI</h2>

    <% if @organisation.errors.any? || @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
        <ul class="text-sm text-red-600 list-disc list-inside">
          <% @organisation.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with(url: signup_path, method: :post, local: true, class: "space-y-4") do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700">Organisation Name</label>
        <input type="text" name="organisation[name]" value="<%= @organisation.name %>" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Your Name</label>
        <input type="text" name="user[name]" value="<%= @user.name %>" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Email</label>
        <input type="email" name="user[email]" value="<%= @user.email %>" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Password</label>
        <input type="password" name="user[password]" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Password Confirmation</label>
        <input type="password" name="user[password_confirmation]" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" />
      </div>

      <div>
        <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
          Create Organisation
        </button>
      </div>
    <% end %>

    <p class="mt-4 text-center text-sm text-gray-600">
      Already have an account? <%= link_to "Sign in", new_user_session_path, class: "text-indigo-600 hover:text-indigo-500" %>
    </p>
  </div>
</div>
