# Required environment variables for ShieldAI

# Rails
RAILS_ENV=production
SECRET_KEY_BASE=your_secret_key_base_here

# Database
DATABASE_URL=postgres://user:password@host:5432/shieldai_production

# Redis (for Sidekiq background jobs)
REDIS_URL=redis://localhost:6379/0

# Email domain restriction (only users with this domain can activate the extension)
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# Admin user (seeded on first db:seed)
ADMIN_EMAIL=admin@yourcompany.com

# SMTP (for magic link emails — use SendGrid or Postmark)
SMTP_HOST=smtp.sendgrid.net
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
MAILER_FROM=noreply@yourcompany.com

# App host (used in generated URLs, e.g. magic link emails)
APP_HOST=your-shieldai-app.onrender.com

# Chrome Extension API URL (update extension/config/api.js to match APP_HOST)
EXTENSION_API_URL=https://your-shieldai-app.onrender.com
