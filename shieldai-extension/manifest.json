{
  "manifest_version": 3,
  "name": "ShieldAI",
  "version": "1.0.0",
  "description": "AI Tool Discovery & Governance",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "setup.html"
}
